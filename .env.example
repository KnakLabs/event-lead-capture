# Copy to .env and fill in. Never commit .env — it is gitignored.
# See README > Setup for where each of these comes from.
#
# This file holds credentials and the ids of YOUR accounts. How your Marketo is
# organised — folder name, program-naming scheme, membership status, notes field
# — lives in `conventions.py` instead. You need to edit both.

# ---------- Slack ----------
# Bot User OAuth Token (xoxb-...) — Slack app > OAuth & Permissions
SLACK_BOT_TOKEN=
# Signing Secret — Slack app > Basic Information > App Credentials.
# Used to prove each request really came from Slack.
SLACK_SIGNING_SECRET=
# OPTIONAL — only for scripts/send_test_messages.py. A USER token (xoxp-), not
# the bot one: the agent ignores mentions posted by a bot, so a test script has
# to post as a person. Slack app > OAuth & Permissions > User Token Scopes:
# chat:write + files:write, then reinstall. See README > Testing.
SLACK_USER_TOKEN=

# ---------- OpenAI (badge reading, the brain, voice transcription) ----------
# Local build only. On deploy this becomes Bedrock for the model calls and
# Amazon Transcribe for audio — see README > Porting checklist.
OPENAI_API_KEY=
# Reads the badge and drives the brain. Defaults to gpt-5.6-terra (balanced).
# gpt-5.6-luna is ~6x cheaper if badge accuracy holds up on your photos;
# gpt-5.6-sol is the flagship if it doesn't.
OPENAI_MODEL=gpt-5.6-terra
# Transcribes voice notes. Defaults to gpt-transcribe (whisper-1 is now legacy).
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# ---------- Clay (enrichment) ----------
# Settings > Account > API keys
CLAY_API_KEY=
# Routine that takes name/company and returns a work email. Build it first —
# README > Setup > step 3 covers the columns it needs. Then on the function:
# Integrations > tick "API & CLI" > copy the Routine ID and enter it here WITH
# the prefix, i.e. function:t_xxxxx
CLAY_ROUTINE_ID=

# ---------- Marketo ----------
# e.g. https://123-abc-456.mktorest.com  (Admin > Web Services, minus /rest)
MARKETO_BASE_URL=
MARKETO_CLIENT_ID=
MARKETO_CLIENT_SECRET=
# Where a human opens a lead — NOT the REST host above, even though both belong
# to the same instance. It is the host you see when you open Marketo in a
# browser, e.g. https://app-ab99.marketo.com. Used for the clickable link in the
# sheet's Marketo Lead column.
MARKETO_UI_HOST=
# How your Marketo is ORGANISED — the events folder, which program names count
# as events, the membership status, and the notes field's API name — is not set
# here. Those are code-shaped (one is a regex), so they live in `conventions.py`
# at the repo root. Edit that file too; the values it ships with are examples.

# ---------- Google Sheets (one tab per event) ----------
# From the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
# Service account key file — a path relative to the project root, or absolute.
# The sheet must be shared with the key's client_email as an Editor.
# NOTE: this file is a private key and is gitignored. On deploy it becomes
# GOOGLE_SERVICE_ACCOUNT_JSON holding the same JSON inline, from Secrets Manager.
GOOGLE_SERVICE_ACCOUNT_FILE=

# ---------- Local runtime (no deployed equivalent) ----------
PORT=3000
